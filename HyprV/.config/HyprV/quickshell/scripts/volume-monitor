#!/usr/bin/env bash
# Emit current volume on start, then re-emit on every PipeWire sink change.
# Output format: "Volume: 0.90" or "Volume: 0.90 [MUTED]" (same as wpctl).

wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true

pactl subscribe 2>/dev/null | while IFS= read -r line; do
    case "$line" in
        *"'change' on sink"*) wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null || true ;;
    esac
done
